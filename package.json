{
  "name": "vietelectro-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev": "npm run dev:client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run build:client && npm run build:server",
    "lint:client": "npm run lint --prefix client",
    "lint:server": "npm run lint --prefix server",
    "lint": "npm run lint:client && npm run lint:server",
    "typecheck:client": "npm run typecheck --prefix client",
    "typecheck:server": "npm run typecheck --prefix server",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "tsc": "npm run typecheck",
    "test:client": "npm run typecheck:client",
    "test:server": "npm run test --prefix server",
    "test": "npm run test:server",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1"
  }
}
